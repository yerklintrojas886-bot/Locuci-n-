# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# REPLICATE_API_TOKEN: Required for AI Stem Separation (Demucs server proxy).
# Set via AI Studio Secrets panel.
REPLICATE_API_TOKEN=MY_REPLICATE_API_TOKEN

# ELEVENLABS_API_KEY: Required for AI authorized custom voice synthesis.
# Set via AI Studio Secrets panel.
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY
